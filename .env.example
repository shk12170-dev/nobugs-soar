# .env 예시. 실제 값은 `python -m nobugs_tools.make_env`로 만든다(무작위 비밀값, 콘솔 출력 없음).
# 이 파일에는 실제 비밀값을 넣지 않는다. .env 자체는 Git에서 제외된다(.gitignore).

# 관제 스택(docker compose)
NB_OPENSEARCH_PASSWORD=change-me-opensearch-initial-admin-password
NB_GRAYLOG_SECRET=change-me-64-hex-chars
NB_GRAYLOG_ROOT_SHA2=change-me-sha256-of-admin-password
NB_GRAYLOG_ADMIN_PASSWORD=change-me-graylog-admin-password
NB_GRAYLOG_URL=http://127.0.0.1:9100
NB_GELF_PORT=12301

# Graylog -> 대응 엔진 웹훅 인증 키
NB_ENGINE_KEY=change-me-engine-webhook-key
# 대응 엔진 -> 포털 대응 API 키(엔진 키와 다른 값)
NB_RESPONSE_API_KEY=change-me-portal-response-key
# 경계 시뮬레이터(S10) 인증 키
NB_BOUNDARY_KEY=change-me-boundary-key

# n8n(관리 화면 로그인 / Graylog -> n8n 웹훅 인증 키)
NB_N8N_USER=admin
NB_N8N_PASSWORD=change-me-n8n-admin-password
NB_N8N_WEBHOOK_KEY=change-me-n8n-webhook-key

# pfSense 방화벽 로그를 호스트 중계기(nobugs_tools.syslog_relay)가 받을 주소. pfSense는 VMware 망에
# 있어 127.0.0.1로는 닿지 못한다. VMnet 호스트 주소를 넣는다(Windows `ipconfig`의 VMware Network Adapter VMnetX).
# Docker Desktop은 UDP 게시 포트 전달이 불안정해 syslog를 직접 못 받는다. 중계기가 이 주소:1514로 받아
# GELF TCP로 Graylog에 넣는다(host를 보낸 IP로 넣어 source가 pfSense로 찍힌다).
NB_SYSLOG_BIND=127.0.0.1
# 중계기 -> Graylog GELF TCP 전달 포트(포털 GELF와 같은 포트)
NB_SYSLOG_GELF_PORT=12301

# 로컬 실행에만 쓰는 값(docker compose는 안 씀)
# NB_RESPONSE_ALLOWED_CIDRS=127.0.0.0/8   # 대응 API를 부를 수 있는 출발지 대역
# NB_GELF_ENABLED=true                    # 포털 이벤트를 Graylog로 보낼지
# NB_ENGINE_DRY_RUN=false                 # 엔진 기본 모드(기본은 모의 실행)
# NB_ENGINE_RELEASE_TTL=90                # 자동 원복 대기 시간(초)
